{
  "openapi": "3.0.0",
  "info": {
    "title": "Mock Label API",
    "version": "1.0.0",
    "description": "A mock label generation API used for testing the return triage agent."
  },
  "paths": {
    "/generateLabel": {
      "post": {
        "summary": "Generate a prepaid return label",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": { "type": "string" },
                  "sku": { "type": "string" },
                  "label_type": { "type": "string", "enum": ["prepaid", "collect"] }
                },
                "required": ["order_id","sku","label_type"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Label created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "label_url": { "type": "string" },
                    "label_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid request" }
        }
      }
    }
  }
}
